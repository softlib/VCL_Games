unit Unit5;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls
//  ,upxStackTraceTool
  ;

type
  TForm5 = class(TForm)
    Button1: TButton;
    Panel1: TPanel;
    Button2: TButton;
    Label1: TLabel;
    Button3: TButton;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button3Click(Sender: TObject);
  private
    { Private declarations }
    procedure DoMonthChanged(Sender: TObject);
  public
    { Public declarations }
  end;

var
  Form5: TForm5;

implementation
uses ChnCalendarGrid;

{$R *.dfm}

var
  Cal: TChnCalendarGrid;
procedure TForm5.Button1Click(Sender: TObject);
// 在设计期从 ChnCalendar 面板拖放，或代码创建：

begin
  Cal := TChnCalendarGrid.Create(Self);

  Cal.Parent := Self.Panel1;
  Cal.Align  := alClient;

 // Cal.CurrentMonth

 Cal.OnMonthChanged:=DoMonthChanged;


 // === 现代风格（默认已开启）===
  Cal.Style             := csModern;

  Cal.TodayBorderColor  := clRed;              // 今天红圈
  Cal.SelectFillColor   := $00DC8040;          // 选中蓝圆
  Cal.HeaderBorderColor := $00D0D0D0;          // 表头底线

 // showmessage('sss');
  // 背景图 + 80% 透明度 + 平铺
  Cal.BackgroundPicture.LoadFromFile('C:\Users\yls\Pictures\bg.jpg');
  Cal.BackgroundAlpha  := 180;   // 0..255
  Cal.BackgroundLayout := cilTile; // 平铺
  Cal.BackgroundColor  := $00FCF8F0;

  // 高亮色
  Cal.TodayColor    := $0090F0A0;
  Cal.SelectedColor := $00F0C080;

 { // === 调大日期数字上下间距 ===
  Cal.DayNumberTopMargin    := 25;   // 数字上方更多留白
  Cal.DayNumberBottomMargin := 8;   // 数字与农历文字之间更多留白
  }
  Cal.DayNumberTopMargin    := 18;   // 数字上方更多留白
  Cal.DayNumberBottomMargin := 6;   // 数字与农历文字之间更多留白
  Cal.GoToToday;

end;

procedure TForm5.Button2Click(Sender: TObject);
begin
  ShowMessage(DateTimeToStr(Cal.SelectedDate));

  ShowMessage(DateTimeToStr(Cal.CurrentMonth));
end;

procedure TForm5.Button3Click(Sender: TObject);
begin
// 跳转到 1949 年 10 月 1 日（新中国成立）
if Cal.GoToTheDate(EncodeDate(1949, 10, 1)) then
  ShowMessage('已跳转到 1949-10-01')
else
  ShowMessage('日期非法');
end;

procedure TForm5.DoMonthChanged(Sender: TObject);
begin
label1.Caption:=DateTimeToStr(Cal.CurrentMonth);
end;

end.
